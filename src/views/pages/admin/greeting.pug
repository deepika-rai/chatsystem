extends ../../layouts/main

block content
    section.dashboard-main-content
        .breadcrumb-arae-bxo.d-flex.justify-content-between.align-items-center.flex-wrap.mb-3
            .breadcrumb-icon-box.d-flex.gap-3.align-items-center
                a.icon-box-in-top(href="javascript:void(0)" title="Customer") 
                    i.bi.bi-building
                a.breadcrumb-icon-box.text-black(href="javascript:void(0)" title="user")
                    | Gretting List
            .d-flex.align-items-center.gap-4.justify-content-end.flex-wrap
                .total-lead-inner-bxo
                    h4 Total Gretting: 
                    span.lead-count-box #{status && status.length ? status.length : 0}
                a.hero-btn.common-btn.warpper-btn.text-white(href="/status-upload/add" title="Add Gretting")
                    i.bi.bi-plus-lg.me-1
                    | Add 

        .row
            .col-xl-12.col-lg-12
                .panel.mb-g
                    .panel-body
                        .product-status
                            .table-responsive.table-size
                                table#pagination.table.table-bordered.table-striped.align-middle.text-center
                                    thead.table-bg-warpper
                                        tr
                                            th(style="width:1%; white-space:nowrap;") #
                                            th Greeting Text
                                            th(style="width:10%; white-space:nowrap;") Status
                                            th(style="width:10%; white-space:nowrap;") Action
                                    tbody.table-bg-warpper-inner
                                        if status && status.length
                                            each data, index in status
                                                tr
                                                    td #{index + 1}
                                                    td #{data.greetingText || '-'}
                                                    td 
                                                        if data.status == 'Active'
                                                            span.table-status-btn Active
                                                        else
                                                            span.inactive-status Inactive
                                                    td 
                                                        .d-flex.justify-content-center.align-items-center.gap-2
                                                            a(href="#", title=(data.status == 1 ? 'Active - Click to inactive' : 'Inactive - Click to active'), class="status-icon",data-id=data.id,data-status=data.status,id=`toggle-${data.id}`)
                                                                if data.status == 'Active'
                                                                    i.bi.bi-check-circle.text-success
                                                                else
                                                                    i.bi.bi-x-circle.text-danger 
                                                            //- span.ios-toggle
                                                            //-     input.toggle-active(
                                                            //-         type="checkbox",
                                                            //-         id=`toggle-${data.id}`,
                                                            //-         data-id=data.id,
                                                            //-         checked=data.status == 'Active'
                                                            //-     )
                                                            //-     label(for=`toggle-${data.id}`)
                                                            a(href=`/status-upload/edit/${data.id}`, title='Edit')
                                                                i.bi.bi-pencil
                                                            a.delete-btn(
                                                                href="javascript:void(0)",
                                                                onclick=`openDeleteModal(${data.id}, '${data.name}')`,
                                                                title="Delete"
                                                            )
                                                                i.bi.bi-trash.text-danger
                                        else
                                            tr
                                                td.text-center(colspan="5") No records found

    // Single reusable delete modal
    .modal.fade#deleteModal(tabindex='-1' aria-hidden='true')
        .modal-dialog.modal-dialog-centered
            .modal-content
                .modal-header
                    h5.modal-title Confirm Delete
                    button.btn-close(type='button' data-bs-dismiss='modal' aria-label='Close')
                .modal-body.modal-body-inner.text-center
                    img(src="/assets/images/deleteLogo.png", alt="trash")
                    p#deleteMessage Are you sure you want to delete this Gretting?
                .modal-footer
                    button.btn.btn-secondary(type='button' data-bs-dismiss='modal') Cancel
                    a#confirmDeleteBtn.btn.btn-danger(href="#") Delete

    script(src='https://code.jquery.com/jquery-3.6.0.min.js')
    script.
        // Toggle active status
        document.querySelectorAll('.status-icon').forEach(icon => {
            icon.addEventListener('click', (e) => {
                e.preventDefault();
                const Id = icon.getAttribute('data-id');
                const currentStatus = (icon.getAttribute('data-status'));
                const newStatus = currentStatus == 'Active' ? 'Inactive' : 'Active';
                fetch(`/status-upload/update-status/${Id}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ status: newStatus })
                })
                .then(res => res.json())
                .then(data => {
                    console.log("Status updated:", data);
                    location.reload();
                })
                .catch(err => {
                    console.error(err);
                    alert("Failed to update status");
                });
            });
        });

        // Delete modal onclick function
        function openDeleteModal(id, name) {
            document.getElementById('deleteMessage').innerHTML =
                `Are you sure you want to delete <b>${name}</b> Gretting?`;
            document.getElementById('confirmDeleteBtn').setAttribute('href', `/status-upload/delete/${id}`);
            new bootstrap.Modal(document.getElementById('deleteModal')).show();
        }
