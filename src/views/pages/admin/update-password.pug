extends ../../layouts/main

block content
  style.
    .profile-box {
      max-width: 600px;
      margin: 40px auto;
      background: #fff;
      padding: 30px;
      border-radius: 12px;
      box-shadow: 0 0 10px rgba(0,0,0,0.05);
    }
    .profile-box h5 {
      font-size: 20px;
      font-weight: 600;
      color: #000;
    }
    .input-icon-wrap {
      position: relative;
    }
    .input-icon-wrap .form-control {
      padding-right: 42px;
    }
    .input-icon-wrap .toggle-eye {
      position: absolute;
      right: 12px;
      top: 50%;
      transform: translateY(-50%);
      cursor: pointer;
      color: #888;
      font-size: 16px;
      background: none;
      border: none;
      padding: 0;
      line-height: 1;
    }
    .toggle-eye:hover { color: #333; }
    .strength-bar {
      height: 5px;
      border-radius: 3px;
      margin-top: 6px;
      transition: width 0.3s, background 0.3s;
      width: 0%;
    }
    .strength-label {
      font-size: 12px;
      margin-top: 3px;
    }

  .page-wrapper
    .page-body
      .container
        .profile-box
          .border-bottom.mb-4
            h5.fw-bold Change Password

          //- Flash messages
          if success && success.length
            each msg in success
              .alert.alert-success.py-2(role="alert")
                i.bi.bi-check-circle.me-2
                | #{msg}
          if error && error.length
            each msg in error
              .alert.alert-danger.py-2(role="alert")
                i.bi.bi-exclamation-circle.me-2
                | #{msg}

          form#changePasswordForm(action="/user/change-password" method="POST" autocomplete="off")

            .mb-3
              label.form-label(for="current_password") Current Password
                span.text-danger *
              .input-icon-wrap
                input#current_password.form-control(
                  type="password"
                  name="current_password"
                  placeholder="Enter current password"
                  required
                  autocomplete="current-password"
                )
                button.toggle-eye(type="button" data-target="current_password" tabindex="-1")
                  i.bi.bi-eye

            .mb-3
              label.form-label(for="new_password") New Password
                span.text-danger *
              .input-icon-wrap
                input#new_password.form-control(
                  type="password"
                  name="new_password"
                  placeholder="Enter new password (min. 8 characters)"
                  required
                  autocomplete="new-password"
                )
                button.toggle-eye(type="button" data-target="new_password" tabindex="-1")
                  i.bi.bi-eye
              .strength-bar#strengthBar
              small#strengthLabel.strength-label.text-muted

            .mb-4
              label.form-label(for="confirm_password") Confirm New Password
                span.text-danger *
              .input-icon-wrap
                input#confirm_password.form-control(
                  type="password"
                  name="confirm_password"
                  placeholder="Re-enter new password"
                  required
                  autocomplete="new-password"
                )
                button.toggle-eye(type="button" data-target="confirm_password" tabindex="-1")
                  i.bi.bi-eye
              small#matchMsg.form-text

            .d-flex.justify-content-end
              button.hero-btn.common-btn.warpper-btn.d-flex.align-items-center.gap-1(type="submit")
                i.bi.bi-shield-lock
                | Update Password

  script.
    // ── Toggle password visibility ──
    document.querySelectorAll('.toggle-eye').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var targetId = btn.getAttribute('data-target');
        var input = document.getElementById(targetId);
        var icon  = btn.querySelector('i');
        if (input.type === 'password') {
          input.type = 'text';
          icon.classList.replace('bi-eye', 'bi-eye-slash');
        } else {
          input.type = 'password';
          icon.classList.replace('bi-eye-slash', 'bi-eye');
        }
      });
    });

    // ── Password strength indicator ──
    var newPassInput  = document.getElementById('new_password');
    var strengthBar   = document.getElementById('strengthBar');
    var strengthLabel = document.getElementById('strengthLabel');

    newPassInput.addEventListener('input', function () {
      var val = this.value;
      var score = 0;
      if (val.length >= 8)                        score++;
      if (/[A-Z]/.test(val))                      score++;
      if (/[0-9]/.test(val))                      score++;
      if (/[^A-Za-z0-9]/.test(val))               score++;

      var widths = ['0%', '25%', '50%', '75%', '100%'];
      var colors = ['', '#e74c3c', '#e67e22', '#f1c40f', '#2ecc71'];
      var labels = ['', 'Weak', 'Fair', 'Good', 'Strong'];

      strengthBar.style.width  = widths[score];
      strengthBar.style.background = colors[score];
      strengthLabel.textContent = val.length ? labels[score] : '';
      strengthLabel.style.color = colors[score];
    });

    // ── Confirm password match indicator ──
    var confirmInput = document.getElementById('confirm_password');
    var matchMsg     = document.getElementById('matchMsg');

    function checkMatch() {
      if (!confirmInput.value) { matchMsg.textContent = ''; return; }
      if (confirmInput.value === newPassInput.value) {
        matchMsg.textContent = '✓ Passwords match';
        matchMsg.style.color = '#2ecc71';
      } else {
        matchMsg.textContent = '✗ Passwords do not match';
        matchMsg.style.color = '#e74c3c';
      }
    }

    confirmInput.addEventListener('input', checkMatch);
    newPassInput.addEventListener('input', checkMatch);

    // ── Client-side submit guard ──
    document.getElementById('changePasswordForm').addEventListener('submit', function (e) {
      if (newPassInput.value.length < 8) {
        e.preventDefault();
        newPassInput.focus();
        alert('New password must be at least 8 characters.');
        return;
      }
      if (newPassInput.value !== confirmInput.value) {
        e.preventDefault();
        confirmInput.focus();
        alert('New password and confirm password do not match.');
      }
    });
