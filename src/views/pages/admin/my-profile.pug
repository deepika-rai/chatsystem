extends ../../layouts/main

block content
  style.
    body {
      background-color: #f4f6f8;
      font-family: 'Inter', sans-serif;
    }
    .profile-box {
      max-width: 950px;
      margin: 40px auto;
      background: #fff;
      padding: 30px;
      border-radius: 12px;
      box-shadow: 0 0 10px rgba(0,0,0,0.05);
    }
    .profile-box h5 {
      font-size: 20px;
      font-weight: 600;
      color: #000 !important;
    }
    .upload-area {
      display: flex;
      align-items: center;
      gap: 20px;
      flex-wrap: wrap;
    }
    .upload-info {
      display: flex;
      flex-direction: column;
      gap: 1px;
    }
    .upload-box {
      width: 100px;
      height: 100px;
      border: 2px solid #ccc;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }
    .upload-box img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 10px;
    }
    .upload-text {
      font-size: 13px;
      color: #777;
    }
    .upload-info button {
      background-color: #4cb050;
      color: #fff;
      border: none;
      padding: 6px 14px;
      border-radius: 4px;
      font-size: 14px;
      cursor: pointer;
      width: 127px;
    }
    .upload-info span {
      font-size: 13px;
      color: #666;
    }

  .page-wrapper
    .page-body
      .container
        .profile-box
          .border-bottom.mb-3
            h5.fw-bold Profile

          form#updateProfileForm(action="/user/update-profile" method="POST" enctype="multipart/form-data")
            .upload-area.mb-4
              .upload-box
                img#previewImage(
                  src=(user &&
                      user.profile &&
                      user.profile !== 'null' &&
                      user.profile !== 'undefined' &&
                      user.profile.trim() !== ''
                      ? '/assets/userimages/' + user.profile
                      : '/assets/images/profile-img.jpg')
                  alt="Preview Image"
                )
              .upload-info
                input#uploadFile(type="file" name="profile" accept="image/*" style="display:none")
                button(type="button" onclick="document.getElementById('uploadFile').click()")
                  i.bi.bi-upload.me-1
                  | Upload File
                span JPG, GIF or PNG. Max size of 800K

            .row.g-3.mb-4 
              .col-md-4
                label.form-label(for="first_name") Full Name
                input#first_name.form-control(type="text" name="full_name" placeholder="Enter full name" value=(user ? user.name : ''))
              .col-md-4
                label.form-label(for="email") Email
                input#email.form-control(type="email" name="email" placeholder="Enter email" value=(user ? user.email : ''))
              .col-md-4
                label.form-label(for="phone") Phone Number
                input#phone.form-control(type="tel" name="mobile" placeholder="Enter phone number" value=(user ? user.phone : ''))
              
            .d-flex.align-items-center.justify-content-end.flex-wrap.gap-2.mt-4
              button.hero-btn.common-btn.warpper-btn.text-white(type="submit") Save Changes

  script.
    const input = document.getElementById('uploadFile');
    const previewImage = document.getElementById('previewImage');
    input.addEventListener('change', function () {
      const file = this.files[0];
      if (file && file.size <= 800000) {
        const reader = new FileReader();
        reader.onload = function (e) {
          previewImage.src = e.target.result;
        };
        reader.readAsDataURL(file);
      } else {
        alert("File must be JPG, PNG, or GIF and under 800KB.");
        this.value = null;
      }
    });

  // Bootstrap icons
  link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css")
