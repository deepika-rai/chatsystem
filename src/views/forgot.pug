doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Login - My Notebook Dashboard
    link(href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet")
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css")
    style.
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: 'Inter', sans-serif;
      }

      body {
        background-color: #f3f0fa;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
      }

      .login-wrapper {
        background-color: #fff;
        padding: 40px;
        border-radius: 12px;
        width: 100%;
        max-width: 400px;
        box-shadow: 0 0 20px rgba(0, 0, 0, 0.05);
      }

      .logo {
        display: flex;
        align-items: center;
        margin-bottom: 20px;
      }

      .logo-circle {
        color: white;
        display: flex;
        align-items: center;
          width: 100%;
        justify-content: center;

      }

      .logo-text {
        margin-left: 12px;
      }

      .logo-text h1 {
        font-size: 24px;
        font-weight: 600;
        color: #4a3f7c;
      }

      .logo-text p {
        font-size: 12px;
        color: #666;
      }

      h2 {
        font-size: 18px;
        font-weight: 600;
        margin-bottom: 24px;
        text-align: center;
      }

      form label {
        font-size: 14px;
        color: #444;
        margin-bottom: 6px;
        display: block;
      }

      form input[type="text"],
      form input[type="password"] {
        width: 100%;
        padding: 12px 14px;
        margin-bottom: 16px;
        border: 1px solid #ccc;
        border-radius: 8px;
        font-size: 14px;
      }

      .password-wrapper {
        position: relative;
      }

      .toggle-eye {
        position: absolute;
        right: 14px;
        top: 50%;
        transform: translateY(-50%);
        cursor: pointer;
        font-size: 16px;
        color: #999;
      }

      .options {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 13px;
        margin-bottom: 24px;
      }

      .options a {
        color: #0162E8;
        text-decoration: none;
      }

      button {
        width: 100%;
        padding: 12px;
        background-color: #0162E8;
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 16px;
        font-weight: 500;
        cursor: pointer;
        transition: 0.3s ease;
      }

      button:hover {
       background-color: #0162E8;
      }

      .signup-text {
        text-align: center;
        margin-top: 20px;
        font-size: 13px;
      }

      .signup-text a {
        color: #0162E8;
        text-decoration: none;
      }

  body
    .login-wrapper
      //- Flash Messages Section
      if message && message.length
        each msg in message
          .alert.alert-success.alert-dismissible.fade.show(role="alert" style="border-left: 5px solid #198754; box-shadow: 0 2px 6px rgba(0,0,0,0.1);")
            i.bi.bi-check-circle-fill.me-2(style="color: #198754;")
            | #{msg}
      if error && error.length
        each err in error
          .alert.alert-danger.alert-dismissible.fade.show(role="alert" style="border-left: 5px solid #dc3545; box-shadow: 0 2px 6px rgba(0,0,0,0.1);")
            i.bi.bi-exclamation-triangle-fill.me-2(style="color: #dc3545;")
            | #{err}
      .logo
        .logo-circle 
          //- img(src="/assets/images/interactify.png" alt="logo")

      h2 Forgot Your Password?

      form(action="forgot" method="post")
        label(for="email") Email
        input.form-control(type='text' name='email' required='' placeholder='Your Email Address')

        button(type='submit') Send Email

      p.signup-text
        | Already have an account?
        a(href="/login") Login
    script.
      setTimeout(() => {
        const alerts = document.querySelectorAll('.alert');
        alerts.forEach(alert => alert.classList.remove('show'));
      }, 5000);