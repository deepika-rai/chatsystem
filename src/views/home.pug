doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title ASI Sanchay — Submit Request
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css")
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css")
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/css/tom-select.default.css")

    style.
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background: #f5f9ff;
        min-height: 100vh;
      }
      .ts-dropdown { z-index: 9999 !important; }
      .ts-wrapper { position: relative; }

      /* Header */
      .public-header {
        //- background: linear-gradient(135deg, #0EA5E9 0%, #0284C7 100%);
        background: white;
        padding: 14px 32px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        box-shadow: 0 2px 12px rgba(2,132,199,0.18);
        position: sticky;
        top: 0;
        z-index: 100;
      }
      .public-header img { height: 42px; object-fit: contain; }
      .header-login-btn {
        background: #fff;
        color: #0EA5E9;
        border: none;
        padding: 7px 20px;
        border-radius: 6px;
        font-weight: 600;
        font-size: 14px;
        text-decoration: none;
        transition: background 0.2s;
      }
      .header-login-btn:hover { background: #e0f2fe; color: #0284C7; }

      /* Hero */
      .hero-section {
        text-align: center;
        padding: 36px 20px 16px;
      }
      .hero-section h1 { font-size: 26px; font-weight: 700; color: #0c3653; margin-bottom: 6px; }
      .hero-section p { color: #64748b; font-size: 14px; max-width: 500px; margin: 0 auto; }
      header p { color: #64748b; font-size: 14px; max-width: 500px; margin: 0 auto; }

    

     

      /* Section label */
      .section-title {
        font-size: 13px;
        font-weight: 700;
        color: #0EA5E9;
        border-bottom: 2px solid #e0f2fe;
        padding-bottom: 6px;
        margin-bottom: 18px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
      }

   
      .footer p{
        color: white; font-size: 14px; max-width: 500px; margin: 0 auto; 
      }

  body
    //- Header
    header.public-header
      if isLoggedIn
        a.header-login-btn(href="/user/dashboard")
          i.bi.bi-grid-1x2(style="margin-right:5px")
          | Go to Dashboard
      else
        a.header-login-btn(href="/login")
          i.bi.bi-box-arrow-in-right(style="margin-right:5px")
          | Login Admin Panel


    //- Hero
    .hero-section
      h1  Chat System with MySQL & Firebase
      p Design and developed by Deepika Verma.



    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js")
    script(src="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/js/tom-select.complete.min.js")


